import tkinter as tk

root = tk.Tk()
root.title("Calculator")
root.geometry("300x400")
root.configure(bg="lightpink")

tk.Label(root, text="First number", bg="lightpink").pack(pady=(10, 0))
calctext1 = tk.Entry(root, font=("Bold", 20), width=10)
calctext1.pack(pady=5)

tk.Label(root, text="Second number", bg="lightpink").pack(pady=(10, 0))
calctext2 = tk.Entry(root, font=("Bold", 20), width=10)
calctext2.pack(pady=5)

result_variable = tk.StringVar()
result_label = tk.Label(root, textvariable=result_variable, font=("Bold", 20), bg="lightpink")
result_label.pack(pady=20)

def calculate(operator):
    try:
        num1 = float(calctext1.get())
        num2 = float(calctext2.get())
    except ValueError:
        result_variable.set("Enter numbers")
        return

    if operator == "+":
        answer = num1 + num2
    elif operator == "-":
        answer = num1 - num2
    elif operator == "*":
        answer = num1 * num2
    elif operator == "/":
        if num2 == 0:
            result_variable.set("Cannot divide by 0")
            return
        answer = num1 / num2

    result_variable.set(f"Result: {answer}")

button_frame = tk.Frame(root, bg="lightpink")
button_frame.pack(pady=10)

for operator in ["+", "-", "*", "/"]:
    tk.Button(button_frame, text=operator, width=3, command=lambda op=operator: calculate(op)).pack(side="left", padx=5)

root.mainloop()