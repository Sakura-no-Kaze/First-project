import tkinter as tk

root = tk.Tk()
root.title("Calculator")
root.geometry("300x400")
root.configure(bg="lightpink")

tk.Label(root, text="Number 1", bg="lightpink").pack()
calctext1 = tk.Entry(root, font=("Bold", 20), width=10)
calctext1.pack()

tk.Label(root, text="Number 2", bg="lightpink").pack()
calctext2 = tk.Entry(root, font=("Bold", 20), width=10)
calctext2.pack()

result_variable = tk.StringVar()
result_label = tk.Label(root, textvariable=result_variable, font=("Bold", 20), bg="lightpink")
result_label.pack()

def calculate(operator):
    try:
        calcnumber1 = float(calctext1.get())
        calcnumber2 = float(calctext2.get())
    except ValueError:
        result_variable.set("Enter numbers")
        return

    if operator == "Add":
        answer = calcnumber1 + calcnumber2
    elif operator == "Subtract":
        answer = calcnumber1 - calcnumber2
    elif operator == "Multiply":
        answer = calcnumber1 * calcnumber2
    elif operator == "Divide":
        if calcnumber2 == 0:
            result_variable.set("You can't divide by 0")
            return
        answer = calcnumber1 / calcnumber2

    result_variable.set(f"Result: {answer}")

button_frame = tk.Frame(root, bg="lightpink")
button_frame.pack()

for operator in ["Add", "Subtract", "Multiply", "Divide"]:
    tk.Button(button_frame, text=operator, width=2, command=lambda operator: calculate()).pack(side="left", padx=5)

root.mainloop()